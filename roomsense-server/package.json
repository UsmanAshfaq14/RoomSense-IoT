{
  "name": "roomsense-server",
  "version": "2.0.0",
  "private": true,
  "description": "RoomSense: MQTT broker, MongoDB and REST API in one Node.js process",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "demo": "node server.js --demo",
    "demo-setup": "node scripts/demo-setup.js",
    "test": "node test/rules.js && node test/e2e.js",
    "test:rules": "node test/rules.js",
    "test:e2e": "node test/e2e.js",
    "reset-stats": "node scripts/reset-stats.js",
    "mqtt-user": "node scripts/mqtt-user.js"
  },
  "dependencies": {
    "aedes": "0.51.3",
    "compression": "1.8.0",
    "express": "4.21.2",
    "mongodb": "6.10.0"
  },
  "devDependencies": {
    "mqtt": "5.10.1"
  }
}
